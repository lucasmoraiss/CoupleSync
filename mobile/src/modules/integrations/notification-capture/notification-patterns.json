{
  "version": "2.0.0",
  "creditMarkers": [
    "\\brecebid[oa]\\b",
    "\\brecebeu\\b",
    "\\bestorn(?:o|ad[oa])\\b",
    "\\breembols(?:o|ad[oa])\\b",
    "\\bdep[oó]sito\\s+(?:de\\s+R\\$|recebido|realizado|identificado|em\\s+(?:sua\\s+)?conta)",
    "\\bcashback\\b",
    "\\b(?:rendeu|rendimento)\\b"
  ],
  "notTransactionMarkers": [
    "\\b(?:negad[oa]|recusad[oa]|cancelad[oa]|bloquead[oa])\\b",
    "\\bn[aã]o\\s+(?:foi\\s+)?(?:autorizad|aprovad|realizad|conclu[ií]d)[oa]\\b",
    "\\b(?:parcele|aproveite|ganhe|garanta|simule|contrate|oferta|promo[cç][aã]o|cupom|sorteio)\\b",
    "\\bpr[eé]-?aprovad[oa]\\b",
    "\\bem\\s+at[eé]\\s+\\d+\\s*x\\b",
    "\\b(?:a\\s+partir|acima)\\s+de\\s+R\\$"
  ],
  "banks": [
    {
      "name": "Nubank",
      "packageNames": ["com.nu.production"],
      "patterns": [
        {
          "id": "nu-purchase",
          "regex": "\\bCompra(?:\\s+aprovada)?(?:\\s+no\\s+(?:d[eé]bito|cr[eé]dito))?:?\\s+(?:de\\s+)?{AMOUNT}(?:\\s+aprovada)?\\s+em\\s+{MERCHANT}",
          "amountGroup": 1,
          "merchantGroup": 2
        },
        {
          "id": "nu-pix-sent",
          "regex": "\\bPix\\s+enviado:?\\s+(?:de\\s+)?{AMOUNT}\\s+para\\s+{MERCHANT}",
          "amountGroup": 1,
          "merchantGroup": 2
        }
      ]
    },
    {
      "name": "Itaú",
      "packageNames": ["com.itau", "br.com.italiquido", "com.itau.empresas"],
      "patterns": [
        {
          "id": "itau-purchase",
          "regex": "\\bCompra(?:\\s+aprovada)?(?:\\s+no\\s+(?:cart[aã]o|d[eé]bito|cr[eé]dito))?:?\\s*(?:de\\s+)?{AMOUNT}\\s*(?:[-–]|em)\\s+{MERCHANT}",
          "amountGroup": 1,
          "merchantGroup": 2
        },
        {
          "id": "itau-pix-sent",
          "regex": "\\bPix\\s+enviado:?\\s*(?:de\\s+)?{AMOUNT}\\s+para\\s+{MERCHANT}",
          "amountGroup": 1,
          "merchantGroup": 2
        },
        {
          "id": "itau-debit",
          "regex": "\\bD[eé]bito\\s+de\\s+{AMOUNT}\\s*[-–]\\s*{MERCHANT}",
          "amountGroup": 1,
          "merchantGroup": 2
        }
      ]
    },
    {
      "name": "Inter",
      "packageNames": ["br.com.intermedium"],
      "patterns": [
        {
          "id": "inter-purchase",
          "regex": "\\bCompra\\s+aprovada:?\\s*(?:de\\s+)?{AMOUNT}\\s+em\\s+{MERCHANT}",
          "amountGroup": 1,
          "merchantGroup": 2
        },
        {
          "id": "inter-pix-sent",
          "regex": "\\bPix\\s+de\\s+{AMOUNT}\\s+enviado\\s+para\\s+{MERCHANT}",
          "amountGroup": 1,
          "merchantGroup": 2
        },
        {
          "id": "inter-spend",
          "regex": "\\bVoc[eê]\\s+gastou\\s+{AMOUNT}\\s+no\\s+Inter\\s+em\\s+{MERCHANT}",
          "amountGroup": 1,
          "merchantGroup": 2
        }
      ]
    },
    {
      "name": "C6 Bank",
      "packageNames": ["com.c6bank.app"],
      "patterns": [
        {
          "id": "c6-purchase",
          "regex": "\\b(?:Compra|Transa[cç][aã]o)\\s+(?:de|aprovada):?\\s*{AMOUNT}\\s+em\\s+{MERCHANT}",
          "amountGroup": 1,
          "merchantGroup": 2
        },
        {
          "id": "c6-pix-sent",
          "regex": "\\bVoc[eê]\\s+enviou\\s+{AMOUNT}\\s+via\\s+Pix\\s+para\\s+{MERCHANT}",
          "amountGroup": 1,
          "merchantGroup": 2
        }
      ]
    },
    {
      "name": "Bradesco",
      "packageNames": ["com.bradesco", "com.bradesco.prestoandroid", "com.bradesco.next"],
      "patterns": [
        {
          "id": "bradesco-purchase",
          "regex": "\\bCompra\\s+(?:aprovada\\s+)?de\\s+{AMOUNT}\\s+em\\s+{MERCHANT}",
          "amountGroup": 1,
          "merchantGroup": 2
        },
        {
          "id": "bradesco-debit",
          "regex": "\\bD[eé]bito\\s+de\\s+{AMOUNT}\\s+em\\s+sua\\s+conta",
          "amountGroup": 1,
          "merchantGroup": null
        },
        {
          "id": "bradesco-pix-sent",
          "regex": "\\bPix\\s+enviado:?\\s*(?:de\\s+)?{AMOUNT}\\s+para\\s+{MERCHANT}",
          "amountGroup": 1,
          "merchantGroup": 2
        }
      ]
    }
  ]
}
