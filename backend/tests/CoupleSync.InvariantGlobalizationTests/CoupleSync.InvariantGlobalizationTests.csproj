<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The whole test process runs with globalization-invariant mode ON (no ICU, as in a minimal Alpine container):
    InvariantGlobalization goes into this assembly's runtimeconfig.json, which the test host uses.
    Anything in the API that silently depends on culture data (named cultures, Unicode normalization) fails here.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\TestDatabaseIsolation.cs" Link="TestDatabaseIsolation.cs" />
    <Compile Include="..\Shared\TestHostSourceGuardTests.cs" Link="TestHostSourceGuardTests.cs" />
    <Compile Include="..\Shared\TestEmailIsolation.cs" Link="TestEmailIsolation.cs" />
    <Compile Include="..\Shared\TestApiFactory.cs" Link="TestApiFactory.cs" />
    <Compile Include="..\Shared\TestHostGuardTests.cs" Link="TestHostGuardTests.cs" />
    <Compile Include="..\Shared\TestHostEnvironmentTests.cs" Link="TestHostEnvironmentTests.cs" />
    <!-- The same category cases the unit tests run with ICU, run again without it. -->
    <Compile Include="..\CoupleSync.UnitTests\Domain\TransactionCategoriesTests.cs" Link="TransactionCategoriesTests.cs" />
    <!-- The text rules of the AI layer compare without accents: the same cases, without ICU. -->
    <Compile Include="..\CoupleSync.UnitTests\Ai\AiTextRulesTests.cs" Link="AiTextRulesTests.cs" />
    <!-- The key of an establishment and the transfer-to-a-person rule fold accents and case: the same cases, without ICU. -->
    <Compile Include="..\CoupleSync.UnitTests\AiFacts\MerchantKeyTests.cs" Link="MerchantKeyTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CoupleSync.Api\CoupleSync.Api.csproj" />
    <ProjectReference Include="..\..\src\CoupleSync.Infrastructure\CoupleSync.Infrastructure.csproj" />
  </ItemGroup>

</Project>
