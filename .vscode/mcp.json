{
	"servers": {
		"io.github.upstash/context7": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"@upstash/context7-mcp@1.0.31"
			],
			"env": {
				"CONTEXT7_API_KEY": "${input:CONTEXT7_API_KEY}"
			},
			"gallery": "https://api.mcp.github.com",
			"version": "1.0.31"
		},
		"github-actions": {
			"type": "stdio",
			"command": "node",
			"args": [
				"${workspaceFolder}/mcp-github-actions/dist/index.js"
			],
			"env": {
				"GITHUB_TOKEN": "${input:GITHUB_PAT}",
				"GITHUB_OWNER": "${input:GITHUB_OWNER}",
				"GITHUB_REPO": "${input:GITHUB_REPO}"
			}
		},
		"mobile-validation": {
			"type": "stdio",
			"command": "node",
			"args": [
				"${workspaceFolder}/mcp-mobile-validation/dist/index.js"
			],
			"env": {
				"ADB_PATH": "${input:ADB_PATH}",
				"MAESTRO_PATH": "${input:MAESTRO_PATH}",
				"SCREENSHOT_DIR": "${workspaceFolder}/.agents-work/screenshots",
				"APP_PACKAGE": "com.couplesync.app",
				"MAESTRO_FLOWS_DIR": "${workspaceFolder}/mobile/tests/e2e/flows",
				"PROJECT_ROOT": "${workspaceFolder}"
			}
		}
	},
	"inputs": [
		{
			"id": "CONTEXT7_API_KEY",
			"type": "promptString",
			"description": "API key for authentication",
			"password": true
		},
		{
			"id": "GITHUB_PAT",
			"type": "promptString",
			"description": "GitHub Personal Access Token (Fine-grained) with Actions read/write permissions",
			"password": true
		},
		{
			"id": "GITHUB_OWNER",
			"type": "promptString",
			"description": "GitHub repository owner (e.g. 'lucasmoraiss')"
		},
		{
			"id": "GITHUB_REPO",
			"type": "promptString",
			"description": "GitHub repository name (e.g. 'CoupleSync')"
		},
		{
			"id": "ADB_PATH",
			"type": "promptString",
			"description": "Path to adb executable (leave empty for 'adb' in PATH, or e.g. 'C:/Users/lucas/AppData/Local/Android/Sdk/platform-tools/adb.exe')"
		},
		{
			"id": "MAESTRO_PATH",
			"type": "promptString",
			"description": "Path to maestro executable (leave empty for 'maestro' in PATH)"
		}
	]
}